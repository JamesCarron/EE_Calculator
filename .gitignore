# No user data in the checkout at all: state and cache live under
# %LOCALAPPDATA%\Auterion\EE_Calculator\ and outputs under
# ~\Documents\Auterion\EE_Calculator\. `pixi run where` prints them.

# pixi environment
/.pixi/

# Python bytecode
__pycache__/
*.pyc

# harness and solver scratch
/tests/.work/
__pycache__/

# Planning material, task summaries and mockups: not in the repo. docs/private is a
# directory junction to a private context folder held outside the checkout, so it is
# never part of a clone. The target path is recorded in the maintainer's own notes.
/docs/private/
